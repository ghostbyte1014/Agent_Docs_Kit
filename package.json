{
  "name": "@ghostbyte/agent-docs-kit",
  "version": "1.3.7",
  "description": "A lightweight, evidence-first CLI for project documentation and guided security and engineering reviews.",
  "type": "module",
  "bin": {
    "agent-docs": "bin/agent-docs.mjs"
  },
  "exports": {
    ".": "./src/api/index.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "content/",
    "templates/",
    "skills/",
    "docs/ARCHITECTURE.md",
    "docs/TESTING_GUIDE.md",
    "docs/COMPATIBILITY.md",
    "docs/VERSIONING_AND_UPGRADES.md",
    "docs/CONTENT_MAINTENANCE.md",
    "docs/GITHUB_AND_NPM_SETUP.md",
    "docs/PUBLISHING_AND_HOSTING.md",
    "docs/PURPOSE.md",
    "docs/REVIEW_GUIDE.md",
    "docs/RELEASE_HISTORY.md",
    "docs/RELEASE_PROCESS.md",
    "docs/SECURITY_MODEL.md",
    "scripts/",
    "site/",
    "tests/",
    "!tests/fixtures",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-site.mjs && node scripts/build-skill.mjs",
    "site:preview": "npm run build && node scripts/preview-site.mjs",
    "doctor": "node bin/agent-docs.mjs doctor",
    "test": "node --test",
    "validate": "node scripts/validate-content.mjs && node scripts/check-links.mjs && node bin/agent-docs.mjs validate",
    "smoke:package": "node scripts/smoke-package.mjs",
    "review:dates": "node scripts/check-review-dates.mjs",
    "release:version-policy": "node scripts/check-version-policy.mjs",
    "release:check": "npm test && npm run validate && node scripts/sync-version.mjs --check && npm run release:version-policy && npm run review:dates && npm run build && npm run smoke:package && npm audit --cache .npm-cache",
    "prepublishOnly": "npm run release:check",
    "sync:version": "node scripts/sync-version.mjs",
    "version": "node scripts/sync-version.mjs && git add README.md docs/RELEASE_PROCESS.md docs/PUBLISHING_AND_HOSTING.md"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "ai-agent",
    "documentation",
    "security-audit",
    "engineering-review",
    "quality"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ghostbyte1014/Agent_Docs_Kit.git"
  },
  "homepage": "https://agent-docs-kit.ghostbyte1014.workers.dev/",
  "bugs": {
    "url": "https://github.com/ghostbyte1014/Agent_Docs_Kit/issues"
  },
  "license": "MIT",
  "author": "ghostbyte1014",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "main": "./src/api/index.mjs",
  "devDependencies": {
    "wrangler": "4.151.0"
  }
}
