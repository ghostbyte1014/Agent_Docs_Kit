{
  "name": "@ghostbyte/agent-docs-kit",
  "version": "4.0.0",
  "description": "Documentation governance, evidence-based security audits, and engineering-quality reviews for software projects.",
  "type": "module",
  "bin": {
    "agent-docs": "bin/agent-docs.mjs"
  },
  "exports": {
    ".": "./src/api/index.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "content/",
    "templates/",
    "skills/",
    "docs/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-site.mjs && node scripts/build-skill.mjs",
    "site:preview": "node scripts/preview-site.mjs",
    "doctor": "node bin/agent-docs.mjs doctor",
    "test": "node --test",
    "validate": "node scripts/validate-content.mjs && node bin/agent-docs.mjs validate",
    "prepublishOnly": "npm run build && npm test && npm run validate"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ai-agent",
    "documentation",
    "security-audit",
    "engineering-review",
    "quality"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ghostbyte1014/Agent_Docs_Kit.git"
  },
  "homepage": "https://ghostbyte1014.github.io/Agent_Docs_Kit/",
  "bugs": {
    "url": "https://github.com/ghostbyte1014/Agent_Docs_Kit/issues"
  },
  "license": "MIT",
  "author": "ghostbyte1014",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "serve.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  }
}
